# The application's environment file. Copy to `.env` and fill in. Never commit `.env`.
#
# Two groups:
#   [used now]  read by code that exists today
#   [planned]   named in docs/08-technical-spec and needed by upcoming stories; the names below are the
#               ones the code will read when those stories land. Filling them early is harmless.
#
# Values that are deliberately NOT here because they live in the database and are changed in the admin
# panel (ADR-018): subscription price, receiving card number, trial switch and length, SMS and
# online-payment switches, the receipt review group.
# Also not here: the backup encryption private key, which must stay off the servers (ADR-015).

# --- Environment ---------------------------------------------------------------------------------------
# [planned] development | staging | production
HB_ENV=development

# --- Database ------------------------------------------------------------------------------------------
# Three roles, one for each part of the application (migration 0031). The migrations create them without
# a login. Local: after `docker compose -f docker-compose.dev.yml up -d` and running the migrations, give
# each a login once:  ALTER ROLE hb_app LOGIN PASSWORD '<password>';  and likewise hb_admin, hb_worker.
# Use a different password for each: the point of three roles is that one part cannot act as another.
# [used now] Application role: what shop members and customers do, sign-in, the bot's chat. Cannot bypass
# row-level security, cannot change ledger entries, cannot read the administrators' tables.
HB_DATABASE_URL=postgresql://hb_app:CHANGE_ME@127.0.0.1:54329/hiso_box
# [used now] Administrators' role: the administrators' side of the API (/api/admin/v1) and the command
# that rotates their second-factor secrets. Required when HB_ADMIN_TG_IDS is set; the API refuses to
# start without it.
HB_ADMIN_DATABASE_URL=postgresql://hb_admin:CHANGE_ME@127.0.0.1:54329/hiso_box
# [used now] Worker's role: the outbox, scheduled jobs, exports and imports, erasure. Required by the
# worker and by `python -m hiso_box.interface.measure_export`.
HB_WORKER_DATABASE_URL=postgresql://hb_worker:CHANGE_ME@127.0.0.1:54329/hiso_box

# [used now] Owner role, used only to run migrations. Never given to the running application.
HB_MIGRATION_URL=postgresql://postgres:postgres@127.0.0.1:54329/hiso_box

# [used now] Tests only: a superuser on a throwaway server. The suite creates and drops its own database.
HB_TEST_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres

# --- Telegram (S1.4, S2.1) -----------------------------------------------------------------------------
# [planned] Token from @BotFather for the bot of THIS environment. Use a separate bot per environment.
HB_BOT_TOKEN=
# [planned] The bot's username without @, used to build deep links and QR codes.
HB_BOT_USERNAME=
# [planned] Secret sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header. 1-256 characters,
# A-Z a-z 0-9 _ - only.  Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
HB_WEBHOOK_SECRET=
# [planned] Public HTTPS origin of this environment, no trailing slash. Webhook, Mini App, and Telegram
# Login all require HTTPS; for local work use a tunnel.
HB_PUBLIC_BASE_URL=https://example.invalid
# [optional] Bearer token the monitoring system sends to read /metrics; at least 16 characters.
# Empty: the endpoint is not served.  Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
HB_METRICS_TOKEN=
# [optional] API rate limits for signed-in callers: a steady rate per minute and the burst allowed above
# it, per user and per shop. The defaults are shown; limits by network address belong to the proxy.
HB_RATE_USER_PER_MINUTE=120
HB_RATE_USER_BURST=60
HB_RATE_SHOP_PER_MINUTE=600
HB_RATE_SHOP_BURST=200
# [optional] The oldest signed data the web login accepts, in seconds (1 to 3600). The default is shown.
HB_WEB_LOGIN_MAX_AGE_SECONDS=300
# [planned] Tests only: token of a second bot used by automated tests, never the development bot.
HB_TEST_BOT_TOKEN=

# --- Security ------------------------------------------------------------------------------------------
# [used now] Server secret. Keys for separate purposes are derived from it: the key that signs the
# five-minute links to stored files (without it no receipt can be opened), and the key that encrypts
# secrets stored in the database (administrator second-factor secrets).
# 32 random bytes, base64.  Generate:  python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Losing it locks administrators out. Changing it is a rotation: see HB_SECRETS_KEY_PREVIOUS below.
# Empty: the administrator's API (/api/admin/v1) is not served at all.
HB_SECRETS_KEY=
# [used now] The server secret that was in use before HB_SECRETS_KEY, set ONLY while that secret is
# being rotated (docs/10-operations/runbooks.md, runbook 4). With it the application still honours
# file links signed a moment ago and still reads second-factor secrets encrypted under the old
# secret, until `python -m hiso_box.interface.rotate_secrets` has re-encrypted them. Nothing new is
# signed or encrypted with it. Same length rule as HB_SECRETS_KEY. Empty at every other time.
HB_SECRETS_KEY_PREVIOUS=
# [used now] Comma-separated numeric Telegram user IDs allowed to sign in to the admin panel (ADR-017).
# Empty: nobody is an administrator and the administrator's API is not served. Anything that is not a
# positive whole number refuses to start.
HB_ADMIN_TG_IDS=
# [optional] The administrators' second factor (ADR-017): `required` (the default, shown) or `off`. Off,
# an administrator with a confirmed second factor is asked for no authenticator code anywhere, sensitive
# settings included (payment cards, the price, the review group, online payment): whoever holds an
# allow-listed Telegram account then holds the whole administrators' side. Stored secrets are kept, so
# `required` brings the codes back with no new enrolment. A person who never confirmed a second factor
# still enrols once. Anything other than the two values refuses to start.
HB_ADMIN_SECOND_FACTOR=required
# The public host administrators' passkeys are made for (a bare host name). Empty: no passkeys.
HB_PASSKEY_HOST=
# [planned] Numeric Telegram chat ID that receives operator alerts and the daily digest.
HB_OPERATOR_CHAT_ID=

# --- File store (S10.2, S14.1, S17.2; ADR-020) ----------------------------------------------------------
# [used now] Which store keeps receipts: "filesystem" (development and tests) or "s3" (staging and
# production). Empty: no store; a payment notice can still be sent, but a receipt is refused.
HB_FILE_STORE=
# [used now] Directory of the filesystem store. Outside the repository; never served by a web server.
HB_FILE_ROOT=
# [used now] S3-compatible store hosted on the service's own servers in Uzbekistan: scheme://host[:port]
# with no path, the bucket, the region name the store signs with ("garage" for Garage, "us-east-1" for
# MinIO unless changed), and the credentials of a key that may read, write and delete in that bucket only.
HB_S3_ENDPOINT=http://127.0.0.1:9000
HB_S3_BUCKET=qarz-files
HB_S3_REGION=us-east-1
HB_S3_ACCESS_KEY=
HB_S3_SECRET_KEY=

# --- Switched-off integrations (M5, M7) -----------------------------------------------------------------
# Leave empty until a registered entity and provider contracts exist. The platform switches for SMS and
# online payment stay off regardless of what is set here.
# [used now] SMS through Eskiz (eskiz.uz), read by the worker only: the e-mail and the password of the
# Eskiz account, and the sender name registered for it ("4546" until an alpha name is registered). The
# sender is configured only when all three are set; with any of them empty nothing is sent. Turning SMS
# on is runbook 12 (docs/10-operations/runbooks.md) and is done by the founder.
HB_ESKIZ_EMAIL=
HB_ESKIZ_PASSWORD=
HB_ESKIZ_SENDER=
HB_CLICK_SERVICE_ID=
HB_CLICK_MERCHANT_ID=
HB_CLICK_SECRET_KEY=
HB_PAYME_MERCHANT_ID=
HB_PAYME_SECRET_KEY=

# --- Database statement timeout --------------------------------------------------------------------------
# [used now] The longest one SQL statement may run, in milliseconds, before the database cancels it: for
# the API and for the worker's jobs. 0 means no limit.
HB_STATEMENT_TIMEOUT_MS=5000
HB_WORKER_STATEMENT_TIMEOUT_MS=60000

# --- Operations alerts (the worker's watch, DEC-078) -----------------------------------------------------
# [optional] Telegram chats that are told when something is wrong (a backup too old, the outbox not
# draining, the API not answering, ...) and when it is right again, separated by commas: your own
# Telegram identifier, or a group's (a negative number; the bot must be a member). It may be the review
# group and is set apart from it. Empty: the watch runs and logs, and tells nobody.
# Prove it after every change:  python -m hiso_box.interface.alert_test   (runbook 16)
HB_ALERT_CHAT_IDS=
# [optional] What the watch reads besides the database. All four are set by the single-host Compose
# overlay itself; elsewhere leave them empty and that part is not watched.
#   the API as the worker reaches it, scheme://host:port (its /healthz, and /metrics with HB_METRICS_TOKEN)
HB_ALERT_API_URL=
#   directories, mounted read-only, where the backup jobs and the copy of the stored files write their figures
HB_ALERT_BACKUP_FIGURES_DIR=
HB_ALERT_FILES_FIGURES_DIR=
#   paths whose filesystems are watched for space (above 80% used), separated by commas
HB_ALERT_DISK_PATHS=
