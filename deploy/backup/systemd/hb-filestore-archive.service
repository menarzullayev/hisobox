# Runs on the standby server. Output goes to the journal: journalctl -u hb-filestore-archive.service
[Unit]
Description=hiso-box: weekly file store archive, part of the weekly backup
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=-/etc/hiso-box-backup/backup.env
ExecStart=/opt/hiso-box-backup/scripts/filestore-sync.sh archive
SyslogIdentifier=hb-filestore-archive
StandardOutput=journal
StandardError=journal
TimeoutStartSec=4h
NoNewPrivileges=yes
ProtectHome=yes
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
