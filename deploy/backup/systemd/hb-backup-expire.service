# Runs on the standby server. Output goes to the journal: journalctl -u hb-backup-expire.service
[Unit]
Description=hiso-box: remove backups the retention rules no longer keep
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=-/etc/hiso-box-backup/backup.env
ExecStart=/opt/hiso-box-backup/scripts/expire.sh
SyslogIdentifier=hb-backup-expire
StandardOutput=journal
StandardError=journal
TimeoutStartSec=2h
NoNewPrivileges=yes
ProtectHome=yes
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
