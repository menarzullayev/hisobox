# Runs on the standby server. Output goes to the journal: journalctl -u hb-backup-full.service
[Unit]
Description=hiso-box: weekly full database backup (pgBackRest)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=-/etc/hiso-box-backup/backup.env
ExecStart=/opt/hiso-box-backup/scripts/backup.sh full
SyslogIdentifier=hb-backup-full
StandardOutput=journal
StandardError=journal
TimeoutStartSec=8h
NoNewPrivileges=yes
ProtectHome=yes
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
