# Runs on the standby server. Output goes to the journal: journalctl -u hb-backup-monthly.service
[Unit]
Description=hiso-box: monthly database dump, kept for twelve months
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=-/etc/hiso-box-backup/backup.env
ExecStart=/opt/hiso-box-backup/scripts/monthly-archive.sh
SyslogIdentifier=hb-backup-monthly
StandardOutput=journal
StandardError=journal
TimeoutStartSec=8h
NoNewPrivileges=yes
ProtectHome=yes
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
