# Settings of the backup scripts. Copy to /etc/hiso-box-backup/backup.env (owner root, mode 0644).
# Read by the systemd units (EnvironmentFile) and by the scripts when they are started by hand.
# Format: NAME=value, no quotes, no expansion. There are no secrets in this file.

# pgBackRest stanza and the application's database.
HB_STANZA=qarz
HB_DATABASE=qarz
HB_PGUSER=postgres

# The repository directory on this host (repo1-path of pgbackrest.conf).
HB_REPO_PATH=/var/lib/pgbackrest

# Where the monthly dumps, the file store archives and the restore test's marker are kept.
# Put it on the same disk as the repository: it is part of the backup.
HB_STATE_DIR=/var/lib/hiso-box-backup

# The directory node_exporter's textfile collector reads (--collector.textfile.directory).
HB_TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector

# How the scripts reach the database this host serves (the replica on the standby). Empty: the
# default Unix socket.
HB_SOURCE_PSQL_ARGS=

# The restore test.
HB_RESTORE_TEST_DIR=/var/tmp
HB_MIGRATIONS_DIR=/srv/hiso_box/backend/migrations/versions
HB_ROWCOUNT_TABLES=shop membership customer ledger_entry

# The file store: rclone remotes, defined in /etc/hiso-box-backup/rclone.conf (owner postgres, mode 0600).
HB_FILES_SOURCE=primary:hb-files
HB_FILES_MIRROR=standby:hb-files
HB_FILES_MAX_DELETE=100

# Thresholds of check.sh, in seconds. The first is the operations document's; the others are 26 hours
# and 8 days.
HB_MAX_WAL_AGE_SECONDS=300
HB_MAX_BACKUP_AGE_SECONDS=93600
HB_MAX_FULL_AGE_SECONDS=691200
