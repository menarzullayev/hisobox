# Settings of the production stack (deploy/production/compose.yml). Copy to a file OUTSIDE the
# repository, readable by the deploying user only, and fill it in:
#
#     install -m 600 deploy/production/.env.example /etc/hiso_box/production.env
#
# Every name a service reads is listed here, grouped by the service that is given it; compose.yml hands
# each service only its own group. What each value means, and how to generate the secrets, is in the
# root .env.example. backend/tests/test_deploy_files.py fails when a setting the application reads is
# missing from this file or is not handed to the service that reads it.
#
# Compose reads this file itself: write a value that contains "$" inside single quotes, or the "$" is
# taken for a variable.

# --- The deployment itself (read by compose and the scripts, given to no service) -----------------------
# Host directory with fullchain.pem and privkey.pem, readable by user 101 (the proxy's user).
DEPLOY_TLS_DIR=
# Host directory where the certificate client writes ACME challenge files.
DEPLOY_ACME_DIR=
# Address and ports the proxy is published on. Empty: every address, 80 and 443.
DEPLOY_BIND=
DEPLOY_HTTP_PORT=
DEPLOY_HTTPS_PORT=
# Image names without a tag; the tag is always the commit. Set both to a registry path once a registry
# exists, and DEPLOY_PULL=1 to pull instead of building on this host.
DEPLOY_BACKEND_IMAGE=
DEPLOY_PROXY_IMAGE=
DEPLOY_PULL=

# --- proxy image, at build time (public: it is part of the shipped pages) ------------------------------
# The bot's username without @ (the root file calls it HB_BOT_USERNAME).
VITE_BOT_USERNAME=
# The site's own address, scheme and host, with no trailing slash: the canonical link, the sharing card
# and the sitemap of the public landing page (/web/) are made from it (frontend/src/web/seo.ts). Set it
# to https:// plus DEPLOY_PUBLIC_HOST. Empty: the page carries no canonical link and no sitemap, and the
# build says so — a canonical pointing at the wrong host is worse than none.
VITE_PUBLIC_ORIGIN=

# --- migrate ---------------------------------------------------------------------------------------------
# The owner connection. Given to the migration only, never to the API or the worker.
HB_MIGRATION_URL=

# --- api and worker --------------------------------------------------------------------------------------
HB_BOT_TOKEN=
HB_FILE_STORE=
HB_FILE_ROOT=
HB_S3_ENDPOINT=
HB_S3_BUCKET=
HB_S3_REGION=
HB_S3_ACCESS_KEY=
HB_S3_SECRET_KEY=

# --- api only --------------------------------------------------------------------------------------------
# The connection of the role hb_app: everything shop members and customers do.
HB_DATABASE_URL=
# The connection of the role hb_admin: the administrators' side. Required when HB_ADMIN_TG_IDS is set.
HB_ADMIN_DATABASE_URL=
HB_WEBHOOK_SECRET=
HB_SECRETS_KEY=
# Only during a rotation of HB_SECRETS_KEY (runbook 4): the secret being replaced. Empty otherwise.
HB_SECRETS_KEY_PREVIOUS=
HB_ADMIN_TG_IDS=
# The administrators' second factor: `required` or `off`. Empty: required. Off, an administrator with a
# confirmed second factor is asked for no code, sensitive settings included; the API logs a warning at
# start, the panel says so, and the worker's watch tells the operators' chat (`AdminSecondFactorOff`).
# Any other value refuses to start.
HB_ADMIN_SECOND_FACTOR=
# The public host administrators' passkeys are made for: a bare host name, such as admin.example.uz.
# Empty: no passkey can be registered or used. Anything that is not a bare host name refuses to start.
HB_PASSKEY_HOST=
HB_METRICS_TOKEN=
HB_RATE_USER_PER_MINUTE=
HB_RATE_USER_BURST=
HB_RATE_SHOP_PER_MINUTE=
HB_RATE_SHOP_BURST=
HB_WEB_LOGIN_MAX_AGE_SECONDS=
HB_STATEMENT_TIMEOUT_MS=
HB_PAYME_MERCHANT_ID=
HB_PAYME_SECRET_KEY=
HB_CLICK_SERVICE_ID=
HB_CLICK_MERCHANT_ID=
HB_CLICK_SECRET_KEY=

# --- worker only -----------------------------------------------------------------------------------------
# The connection of the role hb_worker: the outbox and the scheduled jobs.
HB_WORKER_DATABASE_URL=
HB_WORKER_STATEMENT_TIMEOUT_MS=
# SMS through Eskiz: the account's e-mail and password, and the registered sender name. All three or
# none; empty until a contract exists. Nothing is sent while the platform switch `sms_on` is off.
HB_ESKIZ_EMAIL=
HB_ESKIZ_PASSWORD=
HB_ESKIZ_SENDER=
# The operations alerts (DEC-078): the Telegram chats that are told when something is wrong, separated
# by commas. Empty: the worker watches and logs, and tells nobody. Prove it with the test alert
# (runbook 16). The worker is also handed HB_METRICS_TOKEN, to read the API's counters.
HB_ALERT_CHAT_IDS=
# What the watch reads besides the database. The single-host overlay sets all four itself; on the
# two-server design they stay empty (a monitoring system reads those figures there).
HB_ALERT_API_URL=
HB_ALERT_BACKUP_FIGURES_DIR=
HB_ALERT_FILES_FIGURES_DIR=
HB_ALERT_DISK_PATHS=
