7V12"></path><path d="M3.29 7L12 12l8.71-5M7.5 4.27l9 5.15"></path></svg><span>Katalog</span></a></li><li class="nav__item nav__item--secondary"><a href="#/payables" class="nav__link"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h.01M3 12h.01M3 19h.01M8 5h13M8 12h13M8 19h13"></path></svg><span>Qarzlarim</span></a></li><li class="nav__item nav__item--secondary"><a href="#/reminders" class="nav__link"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.268 21a2 2 0 0 0 3.464 0m-10.47-5.674A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path></svg><span>Eslatmalar</span></a></li><li class="nav__item nav__item--secondary"><a href="#/reports" class="nav__link"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3v16a2 2 0 0 0 2 2h16m-3-4V9m-5 8V5M8 17v-3"></path></svg><span>Hisobotlar</span></a></li><li class="nav__item nav__item--secondary"><a href="#/disputes" class="nav__link"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092a10 10 0 1 0-4.777-4.719"></path></svg><span>E'tirozlar va so'rovlar</span></a></li><li class="nav__item nav__item--secondary"><a href="#/import-export" class="nav__link"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V3m9 12v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10l5 5l5-5"></path></svg><span>Import va eksport</span></a></li><li class="nav__item nav__item--secondary"><a href="#/staff" class="nav__link"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg><span>Xodimlar</span></a></li><li class="nav__item nav__item--secondary"><a href="#/activity" class="nav__link"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h.01M3 12h.01M3 19h.01M8 5h13M8 12h13M8 19h13"></path></svg><span>Amallar jurnali</span></a></li><li class="nav__item nav__item--secondary"><a href="#/subscription" class="nav__link"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect width="20" height="14" x="2" y="5" rx="2"></rect><path d="M2 10h20M6 14h2"></path></svg><span>Obuna</span></a></li><li class="nav__item nav__item--secondary"><a href="#/shop-settings" class="nav__link" aria-current="page"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 5H3m9 14H3M14 3v4m2 10v4m5-9h-9m9 7h-5m5-14h-7m-6 5v4m0-2H3"></path></svg><span>Do'kon sozlamalari</span></a></li><li class="nav__item nav__item--more"><a href="#/more" class="nav__link"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"></circle><circle cx="5" cy="12" r="1"></circle></svg><span>Yana</span></a></li></ul></nav><main class="shell__main" tabindex="-1"><h1 class="shell__title">Do'kon sozlamalari</h1><form class="form" novalidate=""><div class="field"><label for="settings-name">Do'kon nomi</label><input id="settings-name" class="input" autocomplete="off" aria-invalid="false" aria-describedby="settings-name-error" value="Baraka savdo"></div><div class="field"><label for="settings-lang">Do'kon tili</label><select id="settings-lang" class="input"><option value="uz" lang="uz">O'zbekcha</option><option value="uz-Cyrl" lang="uz-Cyrl">Ўзбекча</option><option value="ru" lang="ru">Русский</option><option value="tg" lang="tg">Тоҷикӣ</option><option value="kaa" lang="kaa">Qaraqalpaqsha</option><option value="en" lang="en">English</option></select></div><div class="field"><label for="settings-days">Odatdagi to'lash muddati, kun</label><input id="settings-days" class="input" inputmode="numeric" autocomplete="off" aria-invalid="false" aria-describedby="settings-days-error" value="30"></div><p class="actions"><button type="submit" class="button button--primary">Saqlash</button></p></form><section aria-labelledby="credit-settings-title"><h2 id="credit-settings-title">Nasiya sozlamalari</h2><form class="form" novalidate="" aria-label="Nasiya sozlamalari"><div class="field"><label for="credit-default">Do'konning umumiy limiti, so'm</label><input id="credit-default" class="input input--amount" inputmode="numeric" autocomplete="off" aria-invalid="false" aria-describedby="credit-default-error credit-default-hint" value=""><p class="field__hint" id="credit-default-hint">O'z limiti belgilanmagan har bir mijozga qo'llanadi. Bo'sh qoldirilsa, umumiy limit bo'lmaydi.</p></div><label class="choice"><input type="checkbox"><span>Sotuvchilar limitdan oshirib nasiya yoza oladi (ogohlantirish bilan)</span></label><div class="field"><label class="choice"><input aria-describedby="credit-advances-hint" type="checkbox"><span>Oldindan to'lovni (avans) qabul qilish</span></label><p class="field__hint" id="credit-advances-hint">Mijoz qarzidan ko'p to'lasa, ortig'i uning avansi bo'lib qoladi va keyingi nasiyalarga hisoblanadi.</p></div><p class="actions"><button type="submit" class="button button--primary">Nasiya sozlamalarini saqlash</button></p></form></section><section aria-labelledby="support-title"><h2 id="support-title">Yordam uchun kirish</h2><p>Platforma administratori muammoni hal qilish uchun do'kon mijozlari va yozuvlarini vaqtincha, faqat o'qish uchun ko'ra oladi. U sabab ko'rsatadi, kirish ko'pi bilan 24 soat davom etadi va har bir ko'rishi faoliyat jurnaliga yoziladi. Kirishni istalgan payt tugatishingiz mumkin.</p><p>Hozir hech bir administrator do'kon ma'lumotlarini ko'ra olmaydi.</p><h3>Kirishlar tarixi</h3><div class="empty"><span class="empty__icon"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h.01M3 12h.01M3 19h.01M8 5h13M8 12h13M8 19h13"></path></svg></span><p class="empty__text">Administratorlar bu do'konga hali kirmagan.</p></div></section></main></div>"`;

